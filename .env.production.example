# Copy to .env.production and replace every change-me value before deployment.
POSTGRES_PASSWORD=change-me
ADMIN_TOKEN=change-me

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

LLM_PROVIDER=anthropic
CHEAP_LLM_PROVIDER=gemini
LLM_PROVIDER_FAILOVER=1
LLM_PROVIDER_FALLBACKS=anthropic,openai,gemini
PROVIDER_FAILOVER_COOLDOWN_SECONDS=300
ALLOW_LOCAL_STORYBOARD_FALLBACK=1
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
OPENAI_CODE_MODEL=gpt-5.5
OPENAI_CODE_MODEL_FAST=gpt-5.4-mini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FAST=gemini-2.5-flash-lite
LLM_MAX_TOKENS=4000

TTS_PROVIDER=openai
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
TTS_CACHE_ENABLED=1
VIVACITY_OUTPUT_DIR=/app/outputs

DEFAULT_PIPELINE_PROFILE=template
TEMPLATE_PLANNER=heuristic
ALLOW_LEGACY_PIPELINE=0
PIPELINE_VERSION=template-v1
JOB_EXECUTION_MODE=rq
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=vivacity
RQ_JOB_TIMEOUT_SECONDS=1800
ENABLE_REQUEST_DEDUPLICATION=1
COST_BUDGET_MODE=enforce
MAX_ESTIMATED_COST_USD_PER_VIDEO=0.15
JOB_COST_CEILING_USD=0.50
COST_ROLLING_WINDOW_JOBS=100

# Set this to the effective hourly price of one render worker.
RENDER_COMPUTE_USD_PER_HOUR=0
MANIM_RENDER_QUALITY=h
MANIM_PORTRAIT_RESOLUTION=1080,1920
MANIM_LANDSCAPE_RESOLUTION=1920,1080

TARGET_VIDEOS_PER_DAY=10000
CAPACITY_TARGET_UTILIZATION=0.70
CAPACITY_PLANNING_JOB_SECONDS=180
WORKER_LEASE_SECONDS=900
WORKER_POLL_SECONDS=1
WORKER_RECOVERY_INTERVAL_SECONDS=60
WORKER_MAX_JOBS=50

VISION_QUALITY_CHECK_MODE=sample
VISION_QUALITY_SAMPLE_RATE=0.10
VISION_LABEL_COLLISION_MAX_FRAMES=6

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

CORS_ALLOWED_ORIGINS=https://your-frontend.example

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
