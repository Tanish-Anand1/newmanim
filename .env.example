TTS_CACHE_ENABLED=1
TTS_CACHE_WAIT_SECONDS=90
OPENAI_TTS_1_USD_PER_MILLION_CHARS=15.0
OPENAI_TTS_1_HD_USD_PER_MILLION_CHARS=30.0
ATTEMPT_WALL_CLOCK_LIMIT_SECONDS=720
RATE_LIMIT_RETRY_LIMIT=3
RATE_LIMIT_DEFAULT_SLEEP_SECONDS=30
BATCH_REQUEST_DELAY_SECONDS=3
TOPIC_MAX_TARGET_SECONDS=240
STORYBOARD_INTEGRITY_RETRIES=3
TOPIC_TERM_COVERAGE_THRESHOLD=0.70
TOPIC_TERM_MAX_TERMS=12
VISION_LABEL_COLLISION_MAX_FRAMES=6
VISION_QUALITY_CHECK_MODE=sample
VISION_QUALITY_SAMPLE_RATE=0.10
VIVACITY_WORK_ROOT=../vivacity_job_runs
VIVACITY_CACHE_ROOT=../vivacity_cache
VIVACITY_OUTPUT_DIR=./outputs
LEARNING_MEMORY_DIR=./learning_memory

DEFAULT_PIPELINE_PROFILE=template
TEMPLATE_PLANNER=heuristic
ALLOW_LEGACY_PIPELINE=1
PIPELINE_VERSION=template-v1
JOB_EXECUTION_MODE=inline
REDIS_URL=redis://127.0.0.1:6379/0
RQ_QUEUE_NAME=vivacity
RQ_JOB_TIMEOUT_SECONDS=1800
ENABLE_REQUEST_DEDUPLICATION=1
BATCH_MAX_ITEMS=1000
INLINE_BATCH_MAX_ITEMS=10
MAX_ESTIMATED_COST_USD_PER_VIDEO=0.15
JOB_COST_CEILING_USD=0.50
COST_ROLLING_WINDOW_JOBS=100
COST_BUDGET_MODE=warn
RENDER_COMPUTE_USD_PER_HOUR=0
MANIM_RENDER_QUALITY=m

TARGET_VIDEOS_PER_DAY=10000
CAPACITY_TARGET_UTILIZATION=0.70
CAPACITY_PLANNING_JOB_SECONDS=180
WORKER_LEASE_SECONDS=900
WORKER_POLL_SECONDS=1
WORKER_RECOVERY_INTERVAL_SECONDS=60
WORKER_MAX_JOBS=50

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

# One-line DB swap: replace this with a Postgres SQLAlchemy URL later.
