SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

