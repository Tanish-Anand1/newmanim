GEMINI_INPUT_USD_PER_MILLION_TOKENS=0.3
GEMINI_OUTPUT_USD_PER_MILLION_TOKENS=2.5
OPENAI_REASONING_EFFORT=low
OPENAI_INPUT_USD_PER_MILLION_TOKENS=5.0
OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=30.0
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_SPEED=0.84
